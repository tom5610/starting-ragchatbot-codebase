# Copy this file to .env and fill in the values for your chosen provider.

# AI provider: "anthropic" (direct API) or "bedrock" (Amazon Bedrock)
AI_PROVIDER=bedrock

# Required when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Required when AI_PROVIDER=bedrock (uses AWS credential chain; no API key needed)
AWS_REGION=us-east-1